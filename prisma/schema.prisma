generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  RESIDENT
  GUARD
  ADMIN
  FINANCE_SECRETARY
  PROJECT_ADMIN
  /// The estate chairman's oversight account — read access to dues,
  /// complaints, gate activity and projects/spending, plus posting
  /// announcements. Nothing else is writable through it.
  CHAIRMAN
}

/// Commercial residents (shops, offices) are billed a different monthly dues
/// rate from regular residents — see DuesRate.
enum ResidentType {
  REGULAR
  COMMERCIAL
}

/// Platform-level operator — not scoped to any estate, deliberately kept
/// out of the User model rather than given a null-able estateId, since
/// "belongs to no estate" is a different kind of account, not an edge
/// case of a tenant-scoped one. Manages the mycove-super-admin app at
/// admin.mycove.ng (estate admins live at myestate.mycove.ng instead) —
/// e.g. the estate registry and global reference data like
/// ElectricityDisco, which no single estate should own.
model PlatformAdmin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
}

/// A registry of estates. Every other model in this schema carries its own
/// estateId — a flat, denormalized tenant column on every row rather than
/// relying on join-through from a parent — so every query can filter with a
/// single `WHERE estateId = ...` and it's structurally hard to accidentally
/// leak one estate's data into another's request.
model Estate {
  id                    String   @id @default(cuid())
  code                  String   @unique
  name                  String
  address               String?
  managedBy             String?
  /// Security-desk duty phone shown on every resident's SOS screen —
  /// managed by the estate admin (see EstatesController admin endpoints),
  /// since no GUARD account owns a number residents should dial directly.
  securityGuardPhone    String?
  /// Management-office phone shown alongside the security desk number on
  /// the SOS screen — same admin-managed lifecycle as securityGuardPhone.
  estateAdminPhone      String?
  /// Street names the estate admin preloads, so residents pick their street
  /// from this list and only type a house number. Empty = the estate hasn't
  /// configured any yet, and clients fall back to a free-text house address.
  streets               String[] @default([])
  /// A resident owing MORE than this many months of dues can't generate
  /// visitor passes (they're prompted to pay instead). Admin-configurable
  /// per the estate's policy; null turns the restriction off entirely.
  passRestrictionMonths Int?     @default(2)
  imageBase64           String?
  createdAt             DateTime @default(now())

  users                User[]
  deviceTokens         DeviceToken[]
  sessions             Session[]
  passwordResetOtps    PasswordResetOtp[]
  announcements        Announcement[]
  announcementReads    AnnouncementRead[]
  meetings             Meeting[]
  calendarEntries      CalendarEntry[]
  duesLedgerEntries    DuesLedgerEntry[]
  duesSettings         DuesSettings?
  duesRates            DuesRate[]
  birthdayCelebrations BirthdayCelebration[]
  levies               Levy[]
  levyPayments         LevyPayment[]
  payments             Payment[]
  visitorPasses        VisitorPass[]
  accessLogEntries     AccessLogEntry[]
  projects             Project[]
  projectBudgetLines   ProjectBudgetLine[]
  projectReports       ProjectReport[]
  projectDonations     ProjectDonation[]
  projectPledges       ProjectPledge[]
  spotlights           Spotlight[]
  projectAllocations   ProjectAllocation[]
  invoices             Invoice[]
  polls                Poll[]
  pollOptions          PollOption[]
  pollVotes            PollVote[]
  notifications        Notification[]
  rulesSections        RulesSection[]
  ruleItems            RuleItem[]
  complaints           Complaint[]
  utilityMeters        UtilityMeter[]
  utilityPurchases     UtilityPurchase[]
  wallets              Wallet[]
  walletTransactions   WalletTransaction[]
  householdInvites     HouseholdInvite[]
  voiceLogs            VoiceInteractionLog[]
}

model User {
  id                    String       @id @default(cuid())
  estateId              String
  phone                 String       @unique
  passwordHash          String
  pinHash               String?
  role                  Role
  /// Extra roles this person can act as besides their primary [role] — e.g.
  /// a resident who is also the estate chairman keeps ONE account (same
  /// phone and password) and simply signs in as CHAIRMAN on the admin
  /// website, or as RESIDENT on the mobile app. Each session is issued for
  /// exactly one of these roles (see AuthService.login).
  staffRoles            Role[]       @default([])
  /// Which dues rate this resident is billed at.
  residentType          ResidentType @default(REGULAR)
  /// 'YYYY-MM' — the month the resident moved in / began operating. Dues are billed from here.
  moveInMonth           String?
  /// Birthday as day + month only (no year) — entered by the resident, or the admin.
  birthMonth            Int?
  birthDay              Int?
  fullName              String
  /// The full display address ("12 Palm Street") used everywhere a house is
  /// shown. When street + houseNumber are set it's composed from them (see
  /// composeHouse); legacy/free-text estates just store it directly.
  house                 String?
  street                String?
  houseNumber           String?
  email                 String?
  emergencyContactName  String?
  emergencyContactPhone String?
  vehiclePlates         String[]     @default([])
  mustResetPassword     Boolean      @default(false)
  active                Boolean      @default(true)
  createdAt             DateTime     @default(now())
  /// False for a resident who joined via a household invitation — their
  /// household's dues/levy obligation is already covered by whoever
  /// invited them (see invitedById), so they're excluded from every
  /// dues/levy accrual and roster query rather than being charged again.
  duesLiable            Boolean      @default(true)
  /// Set only for accounts created by accepting a HouseholdInvite — the
  /// resident who sent that invite. Self-relation, not the invite row
  /// itself, so "my household members" is a simple findMany once the
  /// account exists.
  invitedById           String?

  estate                   Estate                @relation(fields: [estateId], references: [id], onDelete: Cascade)
  invitedBy                User?                 @relation("HouseholdInviter", fields: [invitedById], references: [id])
  householdMembers         User[]                @relation("HouseholdInviter")
  householdInvitesSent     HouseholdInvite[]     @relation("HouseholdInviteSender")
  householdInvitesReviewed HouseholdInvite[]     @relation("HouseholdInviteReviewer")
  householdInviteAccepted  HouseholdInvite[]     @relation("HouseholdInviteAcceptedUser")
  announcementReads        AnnouncementRead[]
  calendarEntries          CalendarEntry[]
  duesLedgerEntries        DuesLedgerEntry[]
  levyPayments             LevyPayment[]
  payments                 Payment[]
  visitorPasses            VisitorPass[]         @relation("ResidentPasses")
  guardLogEntries          AccessLogEntry[]      @relation("GuardEntries")
  projectDonations         ProjectDonation[]
  projectPledges           ProjectPledge[]
  pollVotes                PollVote[]
  notifications            Notification[]
  complaints               Complaint[]
  passwordResetOtps        PasswordResetOtp[]
  deviceTokens             DeviceToken[]
  sessions                 Session[]
  duesRatesSet             DuesRate[]            @relation("DuesRateSetBy")
  celebrations             BirthdayCelebration[] @relation("UserCelebrations")
  projectAllocations       ProjectAllocation[]   @relation("AllocatedBy")
  invoicesRaised           Invoice[]             @relation("InvoiceRaisedBy")
  invoicesReviewed         Invoice[]             @relation("InvoiceReviewedBy")
  utilityMeters            UtilityMeter[]
  utilityPurchases         UtilityPurchase[]
  wallet                   Wallet?
  walletTransactions       WalletTransaction[]
  meetingsApproved         Meeting[]             @relation("MeetingApprover")
  voiceLogs                VoiceInteractionLog[]

  @@index([estateId])
}

enum HouseholdInviteStatus {
  PENDING_ADMIN_APPROVAL
  APPROVED
  REJECTED
  ACCEPTED
}

/// A resident inviting another person to become their own, fully
/// independent MyCove account — not a sub-user, not a shared login —
/// while exempting that person from a second, duplicate dues/levy
/// obligation (see User.duesLiable). No SMS/OTP involved (real cost, and
/// this app has no SMS provider anyway): the moment an admin approves the
/// invite, the User account is created right away with a random one-time
/// access code as its password (mustResetPassword: true) — the inviter
/// relays that code to the invitee out-of-band, they log in with their
/// phone + the code through the exact same login screen and force-reset
/// flow every admin-created account already goes through, and the code is
/// cleared the moment that first password reset completes (see
/// AuthService.completeForceReset).
model HouseholdInvite {
  id                 String                @id @default(cuid())
  estateId           String
  invitedByUserId    String
  invitedPhone       String
  invitedFullName    String
  status             HouseholdInviteStatus @default(PENDING_ADMIN_APPROVAL)
  createdAt          DateTime              @default(now())
  respondedAt        DateTime?
  respondedByAdminId String?
  /// The one-time login password shown to the inviter on "My Household"
  /// until the invitee actually uses it — cleared (set null) the moment
  /// they complete their first-login password reset, at which point
  /// status flips to ACCEPTED and acceptedAt is stamped.
  accessCode         String?
  acceptedUserId     String?
  acceptedAt         DateTime?

  estate           Estate @relation(fields: [estateId], references: [id], onDelete: Cascade)
  invitedBy        User   @relation("HouseholdInviteSender", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  respondedByAdmin User?  @relation("HouseholdInviteReviewer", fields: [respondedByAdminId], references: [id])
  acceptedUser     User?  @relation("HouseholdInviteAcceptedUser", fields: [acceptedUserId], references: [id])

  @@index([estateId])
  @@index([invitedPhone])
}

enum DevicePlatform {
  ANDROID
  IOS
}

model DeviceToken {
  id        String         @id @default(cuid())
  estateId  String
  userId    String
  token     String         @unique
  platform  DevicePlatform
  createdAt DateTime       @default(now())

  estate Estate @relation(fields: [estateId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([estateId])
}

/// A login session, one per issued refresh token — [jti] is the refresh
/// token's own jti and gets rotated in place on every /auth/refresh call
/// (the token itself is single-use) rather than spawning a new row, so
/// this reflects one continuous device login, not one row per refresh.
model Session {
  id         String         @id @default(cuid())
  estateId   String
  userId     String
  jti        String         @unique
  platform   DevicePlatform
  deviceName String?
  createdAt  DateTime       @default(now())
  lastUsedAt DateTime       @default(now())

  estate Estate @relation(fields: [estateId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([estateId])
}

model PasswordResetOtp {
  id         String    @id @default(cuid())
  estateId   String
  userId     String
  code       String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  estate Estate @relation(fields: [estateId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([estateId])
}

model BlacklistedToken {
  id        String   @id @default(cuid())
  tokenJti  String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([tokenJti])
  @@index([expiresAt])
}

model Announcement {
  id          String   @id @default(cuid())
  estateId    String
  title       String
  category    String
  body        String
  publishedAt DateTime @default(now())

  estate Estate             @relation(fields: [estateId], references: [id], onDelete: Cascade)
  reads  AnnouncementRead[]

  @@index([estateId])
}

model AnnouncementRead {
  id             String   @id @default(cuid())
  estateId       String
  userId         String
  announcementId String
  readAt         DateTime @default(now())

  estate       Estate       @relation(fields: [estateId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([userId, announcementId])
  @@index([estateId])
}

enum MeetingAiStatus {
  NOT_PROCESSED
  PROCESSED
  FAILED
}

model Meeting {
  id          String   @id @default(cuid())
  estateId    String
  title       String
  date        String
  time        String
  location    String
  agenda      String[]
  // The secretary's own account of what happened, written after the
  // meeting — the source of truth the voice assistant reads verbatim (see
  // AppNotifier._answerLastMeetingReport). Null until someone fills it in.
  // Always resident-visible once written, independent of AI
  // processing/approval below.
  report      String?
  scheduledAt DateTime
  createdAt   DateTime @default(now())

  // Phase 2: an AI pass over `report`, run once when it's written/edited
  // (see MeetingsService.adminCreate/adminUpdate), producing a searchable
  // index over the report — never a replacement for it. Residents and the
  // voice assistant only ever see these fields once an admin has reviewed
  // and approved them (see approvedAt) — see MeetingAiExtractor for the
  // extraction itself.
  aiStatus          MeetingAiStatus @default(NOT_PROCESSED)
  aiTopics          String[]        @default([])
  aiDecisions       String[]        @default([])
  aiActionItems     String[]        @default([])
  aiError           String?
  aiProcessedAt     DateTime?
  approvedAt        DateTime?
  approvedByAdminId String?

  estate          Estate            @relation(fields: [estateId], references: [id], onDelete: Cascade)
  calendarEntries CalendarEntry[]
  approvedByAdmin User?             @relation("MeetingApprover", fields: [approvedByAdminId], references: [id])
  reminders       MeetingReminder[]

  @@index([estateId])
}

enum MeetingReminderKind {
  DAY_OF
  TEN_MINUTES_BEFORE
  STARTED
}

/// One row per (meeting, reminder kind) actually sent — the scheduler's
/// dedup ledger. A minute-tick scanner queries upcoming meetings and tries
/// to create these rows; the unique constraint makes each of the three
/// reminders (day-of, T-10min, started) fire exactly once per meeting even
/// across server restarts or overlapping ticks. Rows are cleared when a
/// meeting is rescheduled (see MeetingsService.adminUpdate) so reminders
/// re-arm against the new time.
model MeetingReminder {
  id        String              @id @default(cuid())
  estateId  String
  meetingId String
  kind      MeetingReminderKind
  sentAt    DateTime            @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@unique([meetingId, kind])
  @@index([estateId])
}

model CalendarEntry {
  id        String   @id @default(cuid())
  estateId  String
  userId    String
  meetingId String
  addedAt   DateTime @default(now())

  estate  Estate  @relation(fields: [estateId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@unique([userId, meetingId])
  @@index([estateId])
}

/// One recorded voice-assistant turn from the mobile app: the raw STT
/// transcript, which intent the on-device keyword parser selected (null =
/// unparsed), the keyword(s) that fired (the parser's own explanation of
/// its choice), extracted parameters, and what the assistant replied or
/// where it navigated. Purely an analysis dataset — batches are reviewed
/// offline to find misclassifications, repeated STT variants ("owing"→
/// "going", "debt"→"date"), confused intents, and false-positive rules,
/// which become reviewed parser changes. Never read by any resident-facing
/// feature.
model VoiceInteractionLog {
  id               String   @id @default(cuid())
  estateId         String
  userId           String
  transcript       String
  intent           String?
  matchedBy        String[] @default([])
  parameters       Json?
  response         String?
  navigationTarget String?
  createdAt        DateTime @default(now())

  estate Estate @relation(fields: [estateId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([estateId, createdAt])
  @@index([userId])
}

enum DuesEntryType {
  CHARGE
  PAYMENT
}

model DuesLedgerEntry {
  id            String        @id @default(cuid())
  estateId      String
  userId        String
  date          String
  desc          String
  type          DuesEntryType
  amount        Int
  mediaBase64   String?
  /// 'YYYY-MM' first/last month a PAYMENT covers — set on payments imported
  /// from before the app existed. periodStart also marks when that
  /// resident's billing began (they may have moved in long before joining
  /// the app), so dues aren't charged for months before it.
  periodStart   String?
  periodEnd     String?
  /// Groups the rows created by one CSV import.
  importBatchId String?
  createdAt     DateTime      @default(now())

  estate Estate @relation(fields: [estateId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([estateId])
}

/// One row per estate (estateId is unique) — the monthly dues rate Finance
/// Secretary sets from the dashboard. Dues accrual reads this rather than a
/// hardcoded amount.
model DuesSettings {
  id            String @id @default(cuid())
  estateId      String @unique
  monthlyAmount Int    @default(45000)

  estate Estate @relation(fields: [estateId], references: [id], onDelete: Cascade)
}

/// The estate's dues rate history, one chain per resident type. A row says
/// "from [effectiveMonth] onward, this type is charged [monthlyAmount]"; the
/// rate for any month is the latest row effective on or before it. Rows are
/// never edited or deleted — changing the rate adds a row — so the estate
/// keeps a record of every previous rate, when it was set and by whom, and
/// which month it took effect. (Replaces the single DuesSettings amount.)
model DuesRate {
  id             String       @id @default(cuid())
  estateId       String
  residentType   ResidentType
  monthlyAmount  Int
  /// 'YYYY-MM' — the first month this rate is charged for.
  effectiveMonth String
  createdAt      DateTime     @default(now())
  createdById    String?

  estate    Estate @relation(fields: [estateId], references: [id], onDelete: Cascade)
  createdBy User?  @relation("DuesRateSetBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([estateId, residentType, effectiveMonth])
}

model Levy {
  id       String @id @default(cuid())
  estateId String
  label    String
  amount   Int
  dueDate  String
  year     Int    @default(2026)

  estate   Estate        @relation(fields: [estateId], references: [id], onDelete: Cascade)
  payments LevyPayment[]

  @@index([year])
  @@index([estateId])
}

model LevyPayment {
  id          String   @id @default(cuid())
  estateId    String
  userId      String
  levyId      String
  mediaBase64 String?
  paidAt      DateTime @default(now())

  estate Estate @relation(fields: [estateId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  levy   Levy   @relation(fields: [levyId], references: [id], onDelete: Cascade)

  @@unique([userId, levyId])
  @@index([estateId])
}

enum PaymentPurpose {
  DUES
  LEVY
  WALLET_TOPUP
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum PaymentMethod {
  PAYSTACK
  WALLET
}

model Payment {
  id        String         @id @default(cuid())
  estateId  String
  userId    String
  reference String         @unique
  purpose   PaymentPurpose
  levyId    String?
  amount    Int
  status    PaymentStatus  @default(PENDING)
  method    PaymentMethod  @default(PAYSTACK)
  createdAt DateTime       @default(now())

  estate Estate @relation(fields: [estateId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([estateId])
}

model VisitorPass {
  id         String   @id @default(cuid())
  estateId   String
  residentId String
  name       String
  phone      String
  plate      String?
  code       String   @unique
  validUntil DateTime
  revoked    Boolean  @default(false)
  createdAt  DateTime @default(now())

  estate           Estate           @relation(fields: [estateId], references: [id], onDelete: Cascade)
  resident         User             @relation("ResidentPasses", fields: [residentId], references: [id], onDelete: Cascade)
  accessLogEntries AccessLogEntry[]

  @@index([residentId])
  @@index([estateId])
}

model AccessLogEntry {
  id            String    @id @default(cuid())
  estateId      String
  visitorPassId String
  guardId       String
  entryAt       DateTime  @default(now())
  exitAt        DateTime?

  estate      Estate      @relation(fields: [estateId], references: [id], onDelete: Cascade)
  visitorPass VisitorPass @relation(fields: [visitorPassId], references: [id], onDelete: Cascade)
  guard       User        @relation("GuardEntries", fields: [guardId], references: [id], onDelete: Cascade)

  @@index([visitorPassId])
  @@index([estateId])
}

enum ProjectStatus {
  IN_PROGRESS
  COMPLETED
}

model Project {
  id          String        @id @default(cuid())
  estateId    String
  title       String
  status      ProjectStatus
  progress    Int
  description String
  goal        Int
  baseRaised  Int
  mediaBase64 String?

  estate      Estate              @relation(fields: [estateId], references: [id], onDelete: Cascade)
  budgetLines ProjectBudgetLine[]
  reports     ProjectReport[]
  donations   ProjectDonation[]
  pledges     ProjectPledge[]
  allocations ProjectAllocation[]
  invoices    Invoice[]

  @@index([estateId])
}

model ProjectBudgetLine {
  id        String @id @default(cuid())
  estateId  String
  projectId String
  label     String
  amount    Int

  estate  Estate  @relation(fields: [estateId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([estateId])
}

model ProjectReport {
  id          String   @id @default(cuid())
  estateId    String
  projectId   String
  author      String
  date        String
  text        String
  mediaBase64 String?
  createdAt   DateTime @default(now())

  estate  Estate  @relation(fields: [estateId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([estateId])
}

model ProjectDonation {
  id        String   @id @default(cuid())
  estateId  String
  projectId String
  userId    String
  amount    Int
  createdAt DateTime @default(now())

  estate  Estate  @relation(fields: [estateId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([estateId])
}

/// A resident's stated intent to donate an amount, distinct from an actual
/// ProjectDonation — lets admins see who committed to give and follow up
/// with a personal reminder before the money actually moves.
model ProjectPledge {
  id          String    @id @default(cuid())
  estateId    String
  projectId   String
  userId      String
  amount      Int
  remindedAt  DateTime?
  fulfilledAt DateTime?
  createdAt   DateTime  @default(now())

  estate  Estate  @relation(fields: [estateId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([estateId])
}

enum SpotlightCategory {
  PERSON
  BUSINESS
  /// Added automatically for a resident's birthday.
  BIRTHDAY
}

/// A resident or local business the estate is celebrating/promoting on the
/// mobile dashboard. Only the most recent active one is shown at a time.
model Spotlight {
  id          String            @id @default(cuid())
  estateId    String
  name        String
  category    SpotlightCategory
  description String
  imageBase64 String?
  phone       String?
  active      Boolean           @default(true)
  createdAt   DateTime          @default(now())

  estate      Estate               @relation(fields: [estateId], references: [id], onDelete: Cascade)
  celebration BirthdayCelebration?

  @@index([estateId])
}

/// One resident's birthday in one year: the photo and party answer they gave
/// when prompted, and what the app has already announced so nothing is sent twice.
model BirthdayCelebration {
  id               String    @id @default(cuid())
  estateId         String
  userId           String
  /// The calendar year of the birthday being celebrated.
  year             Int
  photoBase64      String?
  /// null until the celebrant answers the "will there be a party?" prompt.
  hasParty         Boolean?
  partyAt          DateTime?
  partyVenue       String?
  respondedAt      DateTime?
  promptedAt       DateTime?
  partyAnnouncedAt DateTime?
  wishSentAt       DateTime?
  spotlightId      String?   @unique
  createdAt        DateTime  @default(now())

  estate    Estate     @relation(fields: [estateId], references: [id], onDelete: Cascade)
  user      User       @relation("UserCelebrations", fields: [userId], references: [id], onDelete: Cascade)
  spotlight Spotlight? @relation(fields: [spotlightId], references: [id], onDelete: SetNull)

  @@unique([userId, year])
  @@index([estateId, year])
}

/// Money the Finance Secretary has moved from the estate treasury (total
/// collected dues + levies) into a specific project's budget. The
/// treasury balance is always derived from source transactions — total
/// successful DUES/LEVY payments minus the sum of these — never stored
/// redundantly, so it can't drift out of sync the way earlier seed-data
/// bugs this session did.
model ProjectAllocation {
  id            String   @id @default(cuid())
  estateId      String
  projectId     String
  amount        Int
  allocatedById String
  note          String?
  createdAt     DateTime @default(now())

  estate      Estate  @relation(fields: [estateId], references: [id], onDelete: Cascade)
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  allocatedBy User    @relation("AllocatedBy", fields: [allocatedById], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([estateId])
}

enum InvoiceStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Raised by a PROJECT_ADMIN against a project's allocated budget;
/// approving one by a FINANCE_SECRETARY actually deducts from that
/// project's remaining allocated budget (computed as sum(allocations) -
/// sum(approved invoices)), rejecting one has no financial effect.
model Invoice {
  id           String        @id @default(cuid())
  estateId     String
  projectId    String
  amount       Int
  description  String
  vendor       String?
  mediaBase64  String?
  status       InvoiceStatus @default(PENDING)
  raisedById   String
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime      @default(now())

  estate     Estate  @relation(fields: [estateId], references: [id], onDelete: Cascade)
  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  raisedBy   User    @relation("InvoiceRaisedBy", fields: [raisedById], references: [id], onDelete: Cascade)
  reviewedBy User?   @relation("InvoiceReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([estateId])
}

model Poll {
  id       String   @id @default(cuid())
  estateId String
  question String
  closesAt DateTime

  estate  Estate       @relation(fields: [estateId], references: [id], onDelete: Cascade)
  options PollOption[]
  votes   PollVote[]

  @@index([estateId])
}

model PollOption {
  id        String @id @default(cuid())
  estateId  String
  pollId    String
  label     String
  baseVotes Int

  estate Estate     @relation(fields: [estateId], references: [id], onDelete: Cascade)
  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes  PollVote[]

  @@index([estateId])
}

model PollVote {
  id       String   @id @default(cuid())
  estateId String
  userId   String
  pollId   String
  optionId String
  votedAt  DateTime @default(now())

  estate Estate     @relation(fields: [estateId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([userId, pollId])
  @@index([estateId])
}

model Notification {
  id        String    @id @default(cuid())
  estateId  String
  userId    String
  title     String
  type      String
  createdAt DateTime  @default(now())
  readAt    DateTime?

  estate Estate @relation(fields: [estateId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([estateId])
}

model RulesSection {
  id       String @id @default(cuid())
  estateId String
  title    String
  order    Int

  estate Estate     @relation(fields: [estateId], references: [id], onDelete: Cascade)
  items  RuleItem[]

  @@index([estateId])
}

model RuleItem {
  id        String @id @default(cuid())
  estateId  String
  sectionId String
  text      String
  order     Int

  estate  Estate       @relation(fields: [estateId], references: [id], onDelete: Cascade)
  section RulesSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([estateId])
}

enum ComplaintStatus {
  SUBMITTED
  IN_REVIEW
  RESOLVED
}

model Complaint {
  id          String          @id @default(cuid())
  estateId    String
  userId      String
  category    String
  description String
  ref         String          @unique
  status      ComplaintStatus @default(SUBMITTED)
  createdAt   DateTime        @default(now())

  estate Estate @relation(fields: [estateId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([estateId])
}

enum UtilityType {
  ELECTRICITY
  AIRTIME
}

enum UtilityProviderName {
  VTPASS
  BUYPOWER
}

enum MeterType {
  PREPAID
  POSTPAID
}

enum UtilityPurchaseStatus {
  PENDING
  SUCCESSFUL
  FAILED
}

/// A resident's verified meter, saved so it doesn't need re-verifying with
/// the DISCO on every purchase — verify-once, reuse-many, same shape as how
/// a saved card works on a payments screen.
model UtilityMeter {
  id           String    @id @default(cuid())
  estateId     String
  userId       String
  discoCode    String // provider serviceID, e.g. VTpass's "ikeja-electric"
  discoName    String // display name, e.g. "Ikeja Electric"
  meterNumber  String
  meterType    MeterType
  customerName String?
  address      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  estate    Estate            @relation(fields: [estateId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  purchases UtilityPurchase[]

  @@unique([userId, meterNumber])
  @@index([estateId])
  @@index([userId])
}

/// One row per electricity or airtime purchase attempt. [provider] records
/// whichever provider actually fulfilled it (VTpass primary, Buypower as
/// fallback on a genuine provider failure — never on a request-validation
/// rejection, since the second provider would likely reject the same bad
/// input too); [attemptedProviders] keeps the full failover trail for
/// support/debugging even when the first attempt succeeds.
model UtilityPurchase {
  id                 String                @id @default(cuid())
  estateId           String
  userId             String
  type               UtilityType
  meterId            String? // set for ELECTRICITY, null for AIRTIME
  phone              String? // AIRTIME recipient, or electricity contact phone
  network            String? // AIRTIME only: mtn / airtel / glo / etisalat
  amount             Int
  status             UtilityPurchaseStatus @default(PENDING)
  provider           UtilityProviderName?
  attemptedProviders UtilityProviderName[] @default([])
  requestId          String                @unique // idempotency key sent to the provider
  providerRef        String? // provider's own transaction id
  token              String? // electricity token (prepaid only)
  units              String? // e.g. "79.9 kWh"
  tariff             String?
  failureReason      String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  estate Estate        @relation(fields: [estateId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  meter  UtilityMeter? @relation(fields: [meterId], references: [id])

  @@index([estateId])
  @@index([userId])
}

/// The list of Nigerian electricity DISCOs residents can pick from when
/// buying electricity. Deliberately NOT estate-scoped, unlike everything
/// else in this schema — DISCOs are a national reference list, not
/// per-estate data. [code] is the canonical VTpass-style serviceID stored
/// on UtilityMeter.discoCode/UtilityPurchase and passed to both providers
/// (BuypowerProvider translates it to BuyPower's own short codes
/// internally). [shortCode] is the real-world abbreviation shown in the
/// app (e.g. "IKEDC") — the mobile app also uses it, lowercased, as the
/// bundled logo asset's filename (assets/discos/<shortCode>.png), so
/// changing it here means renaming the matching asset too.
model ElectricityDisco {
  id        String   @id @default(cuid())
  code      String   @unique
  shortCode String
  name      String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum WalletTransactionType {
  TOPUP
  PURCHASE_DEBIT
  REFUND
}

/// One wallet per resident — [balance] is the single source of truth,
/// always updated in the same DB transaction as the WalletTransaction row
/// that explains the change (see WalletService.credit/debit), so the two
/// can never drift out of sync.
model Wallet {
  id        String   @id @default(cuid())
  estateId  String
  userId    String   @unique
  balance   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  estate       Estate              @relation(fields: [estateId], references: [id], onDelete: Cascade)
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@index([estateId])
}

/// Append-only ledger — [amount] is always positive, [type] gives the
/// direction. [reference] is a unique idempotency key (for a purchase
/// debit/refund, the same requestId already used for the VTpass/BuyPower
/// call — see UtilitiesService — so a retried request can't double-debit).
model WalletTransaction {
  id                String                @id @default(cuid())
  estateId          String
  userId            String
  walletId          String
  type              WalletTransactionType
  amount            Int
  balanceAfter      Int
  reference         String                @unique
  description       String?
  utilityPurchaseId String?
  createdAt         DateTime              @default(now())

  estate Estate @relation(fields: [estateId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([estateId])
  @@index([userId])
  @@index([walletId])
}

enum WebsiteLeadStatus {
  NEW
  CONTACTED
  CLOSED
}

/// A "Request a Demo" / contact-form submission from the public marketing
/// site (mycove-website) — not tied to any Estate, since the submitter
/// isn't necessarily an existing customer yet. Read and actioned from the
/// cross-estate platform dashboard (mycove-super-admin), not the
/// per-estate admin app.
model WebsiteLead {
  id         String            @id @default(cuid())
  name       String
  email      String
  estateName String?
  message    String
  status     WebsiteLeadStatus @default(NEW)
  createdAt  DateTime          @default(now())

  @@index([status])
}
