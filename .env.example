DATABASE_URL="postgresql://postgres:postgres@localhost:5433/communityhub"
JWT_SECRET="mycove-dev-secret"

# Paste the full JSON of a Firebase service account key here (Firebase Console
# → Project Settings → Service Accounts → Generate new private key) to enable
# push notifications. Leave unset to run with push disabled.
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'

# VTpass (primary electricity/airtime provider) — from vtpass.com/account
# (sandbox.vtpass.com/account for testing) → API Keys tab. Leave unset to
# run with VTpass treated as unavailable (utilities purchases will fail
# over to BuyPower, or fail outright if that's unconfigured too).
# VTPASS_BASE_URL="https://sandbox.vtpass.com/api"
# VTPASS_API_KEY=""
# VTPASS_PUBLIC_KEY=""
# VTPASS_SECRET_KEY=""

# Mixpanel (product analytics) — project token from mixpanel.com →
# Project Settings. Leave unset to run with server-side analytics disabled.
MIXPANEL_TOKEN="2a61ab19563d6f61331f2d469bf8d24a"

# BuyPower (secondary/fallback electricity+airtime provider) — from the
# BuyPower B2B dashboard's API Tokens page. BUYPOWER_BASE_URL defaults to
# the dev/sandbox host below; switch to https://api.buypower.ng/v2 for
# production. Leave BUYPOWER_API_TOKEN unset to run with BuyPower treated
# as unavailable (falls over from VTpass, or fails outright if VTpass is
# unconfigured too).
# BUYPOWER_BASE_URL="https://idev.buypower.ng/v2"
# BUYPOWER_API_TOKEN=""
