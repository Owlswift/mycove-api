DATABASE_URL="postgresql://postgres:postgres@localhost:5433/mycove"
JWT_SECRET="mycove-dev-secret"

# Paste the full JSON of a Firebase service account key here (Firebase Console
# → Project Settings → Service Accounts → Generate new private key) to enable
# push notifications. Leave unset to run with push disabled.
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'

# VTpass (primary electricity/airtime provider) — from vtpass.com/account
# (sandbox.vtpass.com/account for testing) → API Keys tab. Leave unset to
# run with VTpass treated as unavailable (utilities purchases will fail
# over to BuyPower, or fail outright if that's unconfigured too).
# VTPASS_BASE_URL="https://sandbox.vtpass.com/api"
# VTPASS_API_KEY=""
# VTPASS_PUBLIC_KEY=""
# VTPASS_SECRET_KEY=""

# Mixpanel (product analytics) — project token from mixpanel.com →
# Project Settings. Leave unset to run with server-side analytics disabled.
MIXPANEL_TOKEN="2a61ab19563d6f61331f2d469bf8d24a"

# BuyPower (secondary/fallback electricity+airtime provider) — from the
# BuyPower B2B dashboard's API Tokens page. BUYPOWER_BASE_URL defaults to
# the dev/sandbox host below; switch to https://api.buypower.ng/v2 for
# production. Leave BUYPOWER_API_TOKEN unset to run with BuyPower treated
# as unavailable (falls over from VTpass, or fails outright if VTpass is
# unconfigured too).
# BUYPOWER_BASE_URL="https://idev.buypower.ng/v2"
# BUYPOWER_API_TOKEN=""

# Paystack (dues/levy payments) — from the Paystack dashboard's Settings →
# API Keys & Webhooks page. Use the sk_test_/pk_test_ pair while verifying,
# switch to sk_live_/pk_live_ only once the full checkout+webhook loop is
# proven working. Leave PAYSTACK_SECRET_KEY unset to run with dues/levy
# payments backed by MockPaystackGateway (fakes success ~1.4s after every
# initiate() call, no real checkout) instead of a real transaction.
#
# PAYSTACK_PUBLIC_KEY is not used server-side at all — this integration
# redirects residents to Paystack's hosted checkout page rather than using
# Paystack's inline JS/native SDK, which is the only place the public key
# would matter. Kept here only for reference.
#
# After setting PAYSTACK_SECRET_KEY, also register this URL as a webhook
# in the Paystack dashboard (once for test mode, again for live mode):
#   https://api.mycove.ng/api/payments/webhook/paystack
# PAYSTACK_SECRET_KEY=""
# PAYSTACK_PUBLIC_KEY=""

# Collections Intelligence (AI-generated gate-denial payment offers and
# arrears reminders) — an OpenAI-compatible chat completions endpoint.
# Defaults to a local Ollama instance running gpt-oss:20b. Point these at a
# hosted provider later without changing any calling code.
# OLLAMA_BASE_URL="http://localhost:11434"
# OLLAMA_MODEL="gpt-oss:20b"
